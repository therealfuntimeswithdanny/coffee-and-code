    "deploy": "npm run build:auth && wrangler deploy"
  },
  "dependencies": {
    "@atproto/oauth-client-browser": "^0.5.10",
    "hono": "^4.0.0",
    "marked": "^12.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240320.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0",
    "wrangler": "^3.0.0"
  }
}
