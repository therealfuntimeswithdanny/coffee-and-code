{
  "name": "coffee-and-code",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:auth": "esbuild src/client/atproto-auth.ts --bundle --minify --platform=browser --format=esm --target=es2022 --outfile=media/components/atproto-auth.js",
