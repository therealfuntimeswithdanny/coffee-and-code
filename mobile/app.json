{
  "expo": {
    "name": "Coffee & Code",
    "slug": "coffee-and-code",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#281914"
    },
    "orientation": "portrait",
    "scheme": "cc.coffeencode",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cc.coffeencode.ios",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Coffee & Code uses your local network to find and connect to the Expo development server on your Mac while testing.",
        "NSBonjourServices": ["_expo._tcp"]
      }
    },
    "plugins": [
      "expo-web-browser",
      "expo-dev-client"
    ]
  }
}
