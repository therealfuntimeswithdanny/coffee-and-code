# Bind the API to loopback. cloudflared connects to this address.
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=/var/lib/notification-intake/notifications.sqlite3

# Cloudflare Access service token. Create an Access Service Auth policy for
# the published hostname and configure the same values in the Worker secrets.
ACCESS_CLIENT_ID=replace-me.access
ACCESS_CLIENT_SECRET=replace-me

# Optional Jetstream-compatible WebSocket URL.
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
