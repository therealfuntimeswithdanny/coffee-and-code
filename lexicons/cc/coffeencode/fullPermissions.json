{
  "lexicon": 1,
  "id": "cc.coffeencode.fullPermissions",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Coffee & Code Profile",
      "detail": "Manage your likes, dislikes, comments, reads, saves, follows, and author profile created for the Coffee & Code website.",
      "permissions": [
        {
          "type": "permission",
          "resource": "repo",
          "collection": [
            "cc.coffeencode.interact.like",
            "cc.coffeencode.interact.dislike",
            "cc.coffeencode.comment.like",
            "cc.coffeencode.save"
          ],
          "action": [
            "create",
            "delete"
          ]
        },
        {
          "type": "permission",
          "resource": "repo",
          "collection": [
            "cc.coffeencode.interact.view",
            "cc.coffeencode.handle.claim"
          ],
          "action": [
            "create"
          ]
        },
        {
          "type": "permission",
          "resource": "repo",
          "collection": [
            "cc.coffeencode.comment"
          ],
          "action": [
            "create",
            "update",
            "delete"
          ]
        },
        {
          "type": "permission",
          "resource": "repo",
          "collection": [
            "cc.coffeencode.author.profile"
          ],
          "action": [
            "create",
            "update"
          ]
        },
        {
          "type": "permission",
          "resource": "repo",
          "collection": [
            "app.bsky.graph.follow",
            "site.standard.graph.subscription"
          ],
          "action": [
            "create",
            "delete"
          ]
        }
      ]
    }
  }
}
