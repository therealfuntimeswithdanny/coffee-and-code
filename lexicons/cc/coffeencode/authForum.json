{
  "lexicon": 1,
  "id": "cc.coffeencode.authForum",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Coffee & Code Forum",
      "detail": "Create, update, and delete your forum posts, replies, and votes, and upload images to attach to them.",
      "permissions": [
        {
          "type": "permission",
          "action": [
            "create",
            "update",
            "delete"
          ],
          "resource": "repo",
          "collection": [
            "cc.coffeencode.forum.post",
            "cc.coffeencode.forum.reply"
          ]
        },
        {
          "type": "permission",
          "action": [
            "create",
            "delete"
          ],
          "resource": "repo",
          "collection": [
            "cc.coffeencode.forum.vote"
          ]
        },
        {
          "type": "permission",
          "accept": [
            "image/*"
          ],
          "resource": "blob"
        }
      ]
    }
  }
}
