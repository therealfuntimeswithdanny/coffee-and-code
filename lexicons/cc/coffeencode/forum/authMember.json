{
  "lexicon": 1,
  "id": "cc.coffeencode.forum.authMember",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Coffee & Code Forum (Member)",
      "detail": "Create, update, and delete your forum posts, replies, and votes, and upload images to attach to them.",
      "permissions": [
        {
          "type": "permission",
          "resource": "repo",
          "collection": ["cc.coffeencode.forum.post", "cc.coffeencode.forum.reply"],
          "action": ["create", "update", "delete"]
        },
        {
          "type": "permission",
          "resource": "repo",
          "collection": ["cc.coffeencode.forum.vote"],
          "action": ["create", "delete"]
        },
        {
          "type": "permission",
          "resource": "blob",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
