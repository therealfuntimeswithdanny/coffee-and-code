{
  "lexicon": 1,
  "id": "cc.coffeencode.authAuthor",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Coffee & Code Author Profile",
      "detail": "Manage your author profile and post metadata, post and reply in the forum, and publish forum moderation actions.",
      "permissions": [
        {
          "type": "permission",
          "action": [
            "create",
            "update",
            "delete"
          ],
          "resource": "repo",
          "collection": [
            "cc.coffeencode.author.dictionary",
            "cc.coffeencode.author.draft",
            "cc.coffeencode.author.profile",
            "cc.coffeencode.forum.moderation",
            "cc.coffeencode.post.metadata",
            "pub.leaflet.document",
            "site.standard.document"
          ]
        },
        {
          "type": "permission",
          "accept": [
            "image/*"
          ],
          "resource": "blob"
        }
      ]
    }
  }
}
