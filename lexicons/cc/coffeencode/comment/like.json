{
  "lexicon": 1,
  "id": "cc.coffeencode.comment.like",
  "defs": {
    "main": {
      "type": "record",
      "description": "A like for a Coffee & Code comment.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["subject", "createdAt"],
        "properties": {
          "subject": { "type": "ref", "ref": "#subject" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "subject": {
      "type": "object",
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" }
      }
    }
  }
}
